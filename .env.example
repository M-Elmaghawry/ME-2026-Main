# EmailJS credentials — get them from https://www.emailjs.com/
# 1. Create a free account at emailjs.com
# 2. Add Gmail as a service → copy the Service ID
# 3. Create an email template → copy the Template ID
# 4. Go to Account → API Keys → copy the Public Key

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional public reCAPTCHA v2 checkbox site key. Enable v2 verification in the
# EmailJS template and store the CAPTCHA secret in EmailJS, never in VITE_*.
# VITE_RECAPTCHA_SITE_KEY=

# Optional: custom base path
# VITE_BASE_PATH=/

# Public canonical URL, including a repository path when applicable.
# VITE_SITE_URL=https://elmekawy-bim.com/
